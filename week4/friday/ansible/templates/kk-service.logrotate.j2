{{ kk_log_dir }}/{{ kk_service_name }}.log {
    {{ kk_logrotate_frequency }}
    rotate {{ kk_logrotate_rotate }}
    compress
    delaycompress
    missingok
    notifempty
    create 0640 {{ kk_service_user }} {{ kk_service_group }}
    sharedscripts
    postrotate
        systemctl kill -s HUP {{ kk_service_name }}.service >/dev/null 2>&1 || true
    endscript
}
